PatchAssessmentResources
| where type endswith '/patchassessmentresults/softwarepatches'
| extend
    ResourceIdMaquina = tolower(extract(@'(?i)^(.*?)/patchassessmentresults/', 1, id)),
    NomeAtualizacao = coalesce(tostring(properties.patchName), name),
    KBID = tostring(properties.kbid),
    Versao = tostring(properties.version),
    Classificacoes = tostring(properties.classifications),
    PublicadaEmUTC = todatetime(properties.publishedDateTime),
    UltimaModificacaoUTC = todatetime(properties.lastModifiedDateTime),
    ReinicializacaoNecessaria = tostring(properties.rebootRequired),
    ComportamentoReinicio = tostring(properties.rebootBehavior)
| join kind=leftouter (
    Resources
    | project
        ResourceIdMaquina = tolower(id),
        NomeMaquina = name,
        TipoMaquina = type,
        resourceGroup,
        Localizacao = location
) on ResourceIdMaquina
| project-away ResourceIdMaquina1
| join kind=leftouter (
    ResourceContainers
    | where type =~ 'microsoft.resources/subscriptions'
    | project subscriptionId, NomeSubscription = name
) on subscriptionId
| project-away subscriptionId1
| project
    NomeSubscription,
    subscriptionId,
    resourceGroup,
    NomeMaquina,
    TipoMaquina,
    Localizacao,
    NomeAtualizacao,
    KBID,
    Versao,
    Classificacoes,
    PublicadaEmUTC,
    UltimaModificacaoUTC,
    ReinicializacaoNecessaria,
    ComportamentoReinicio,
    ResourceIdMaquina,
    RegistroPatchId = id
| order by NomeSubscription asc, NomeMaquina asc, Classificacoes asc, NomeAtualizacao asc
