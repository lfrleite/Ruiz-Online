// Para filtrar por subscriptions, insira após a linha "Resources":
// | where subscriptionId in (
//     'SUBSCRIPTION-ID-1',
//     'SUBSCRIPTION-ID-2'
// )

Resources
| where type in~ (
    'microsoft.web/sites',
    'microsoft.web/sites/slots'
)
| extend
    ResourceId = tostring(id),
    ResourceType = tostring(type),
    NomeCompleto = tostring(name),
    AppKind = tostring(kind),
    AppServicePlanId = tolower(tostring(properties.serverFarmId))
| extend
    AppName = case(
        ResourceType =~ 'microsoft.web/sites/slots', tostring(split(NomeCompleto, '/')[0]),
        NomeCompleto
    ),
    SlotName = case(
        ResourceType =~ 'microsoft.web/sites/slots', tostring(split(NomeCompleto, '/')[1]),
        ''
    ),
    TipoWorkload = case(
        ResourceType =~ 'microsoft.web/sites/slots', 'Slot',
        AppKind has 'functionapp', 'Function App',
        AppKind has 'workflowapp', 'Logic App Standard',
        AppKind has 'api', 'API App',
        'App Service'
    ),
    ConfigResourceId = tolower(strcat(ResourceId, '/config/web'))
| join kind=leftouter (
    ResourceContainers
    | where type =~ 'microsoft.resources/subscriptions'
    | project subscriptionId, NomeSubscription = name
) on subscriptionId
| project-away subscriptionId1
| join kind=leftouter (
    Resources
    | where type =~ 'microsoft.web/serverfarms'
    | extend AppServicePlanId = tolower(id)
    | project
        AppServicePlanId,
        AppServicePlanName = name,
        AppServicePlanResourceGroup = resourceGroup,
        AppServicePlanLocation = location,
        AppServicePlanSkuName = tostring(sku.name),
        AppServicePlanSkuTier = tostring(sku.tier),
        AppServicePlanSkuSize = tostring(sku.size),
        AppServicePlanSkuCapacity = tostring(sku.capacity),
        AppServicePlanKind = tostring(kind),
        AppServicePlanReservedLinux = tostring(properties.reserved),
        AppServicePlanZoneRedundant = tostring(properties.zoneRedundant)
) on AppServicePlanId
| project-away AppServicePlanId1
| join kind=leftouter (
    AppServiceResources
    | where type in~ (
        'microsoft.web/sites/config',
        'microsoft.web/sites/slots/config'
    )
    | extend ConfigResourceId = tolower(id)
    | project
        ConfigResourceId,
        LinuxFxVersion = coalesce(tostring(properties.LinuxFxVersion), tostring(properties.linuxFxVersion)),
        WindowsFxVersion = coalesce(tostring(properties.WindowsFxVersion), tostring(properties.windowsFxVersion)),
        NetFrameworkVersion = coalesce(tostring(properties.NetFrameworkVersion), tostring(properties.netFrameworkVersion)),
        JavaVersion = coalesce(tostring(properties.JavaVersion), tostring(properties.javaVersion)),
        JavaContainer = coalesce(tostring(properties.JavaContainer), tostring(properties.javaContainer)),
        JavaContainerVersion = coalesce(tostring(properties.JavaContainerVersion), tostring(properties.javaContainerVersion)),
        PhpVersion = coalesce(tostring(properties.PhpVersion), tostring(properties.phpVersion)),
        PythonVersion = coalesce(tostring(properties.PythonVersion), tostring(properties.pythonVersion)),
        NodeVersion = coalesce(tostring(properties.NodeVersion), tostring(properties.nodeVersion)),
        PowerShellVersion = coalesce(tostring(properties.PowerShellVersion), tostring(properties.powerShellVersion)),
        AlwaysOn = coalesce(tostring(properties.AlwaysOn), tostring(properties.alwaysOn)),
        Http20Enabled = coalesce(tostring(properties.Http20Enabled), tostring(properties.http20Enabled)),
        WebSocketsEnabled = coalesce(tostring(properties.WebSocketsEnabled), tostring(properties.webSocketsEnabled)),
        HealthCheckPath = coalesce(tostring(properties.HealthCheckPath), tostring(properties.healthCheckPath)),
        Use32BitWorkerProcess = coalesce(tostring(properties.Use32BitWorkerProcess), tostring(properties.use32BitWorkerProcess))
) on ConfigResourceId
| project-away ConfigResourceId1
| extend
    RuntimePrincipal = case(
        isnotempty(LinuxFxVersion), LinuxFxVersion,
        isnotempty(WindowsFxVersion), WindowsFxVersion,
        isnotempty(JavaVersion), strcat('JAVA|', JavaVersion),
        isnotempty(PythonVersion), strcat('PYTHON|', PythonVersion),
        isnotempty(NodeVersion), strcat('NODE|', NodeVersion),
        isnotempty(PhpVersion), strcat('PHP|', PhpVersion),
        isnotempty(PowerShellVersion), strcat('POWERSHELL|', PowerShellVersion),
        isnotempty(NetFrameworkVersion), strcat('DOTNET_FRAMEWORK|', NetFrameworkVersion),
        'Nao identificado'
    ),
    CreatedAtUTC = todatetime(systemData.createdAt),
    LastModifiedUTC = todatetime(properties.lastModifiedTimeUtc),
    State = tostring(properties.state),
    Enabled = tostring(properties.enabled),
    AvailabilityState = tostring(properties.availabilityState),
    DefaultHostName = tostring(properties.defaultHostName),
    PublicNetworkAccess = tostring(properties.publicNetworkAccess),
    HttpsOnly = tostring(properties.httpsOnly),
    IdentityType = tostring(identity.type),
    IdentityPrincipalId = tostring(identity.principalId)
| project
    NomeSubscription,
    subscriptionId,
    resourceGroup,
    TipoWorkload,
    AppName,
    SlotName,
    NomeCompleto,
    AppKind,
    ResourceType,
    location,
    State,
    Enabled,
    AvailabilityState,
    AppServicePlanName,
    AppServicePlanResourceGroup,
    AppServicePlanLocation,
    AppServicePlanSkuName,
    AppServicePlanSkuTier,
    AppServicePlanSkuSize,
    AppServicePlanSkuCapacity,
    AppServicePlanKind,
    AppServicePlanReservedLinux,
    AppServicePlanZoneRedundant,
    RuntimePrincipal,
    LinuxFxVersion,
    WindowsFxVersion,
    NetFrameworkVersion,
    JavaVersion,
    JavaContainer,
    JavaContainerVersion,
    PhpVersion,
    PythonVersion,
    NodeVersion,
    PowerShellVersion,
    AlwaysOn,
    Http20Enabled,
    WebSocketsEnabled,
    HealthCheckPath,
    Use32BitWorkerProcess,
    HttpsOnly,
    PublicNetworkAccess,
    DefaultHostName,
    IdentityType,
    IdentityPrincipalId,
    CreatedAtUTC,
    LastModifiedUTC,
    Tags = tostring(tags),
    ResourceId
| order by NomeSubscription asc, resourceGroup asc, TipoWorkload asc, AppName asc, SlotName asc
