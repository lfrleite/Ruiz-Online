// Para filtrar por subscriptions, insira após a linha "SecurityResources":
// | where subscriptionId in (
//     'SUBSCRIPTION-ID-1',
//     'SUBSCRIPTION-ID-2'
// )

SecurityResources
| where type =~ 'microsoft.security/securescores'
| extend
    Iniciativa = coalesce(tostring(properties.displayName), tostring(name)),
    ScoreAtual = todouble(properties.score.current),
    ScoreMaximo = todouble(properties.score.max),
    Peso = todouble(properties.weight),
    Percentual = iff(
        todouble(properties.score.max) == 0,
        real(null),
        round(100.0 * todouble(properties.score.current) / todouble(properties.score.max), 2)
    ),
    PontosDisponiveis = round(
        todouble(properties.score.max) - todouble(properties.score.current),
        2
    )
| extend
    Recomendacao = case(
        PontosDisponiveis <= 0, 'Manter acompanhamento do Secure Score',
        Percentual < 50, 'Priorizar controles com maior quantidade de pontos disponíveis',
        Percentual < 80, 'Executar plano contínuo de melhoria dos controles',
        'Revisar controles restantes e manter evolução'
    ),
    Causa = iff(
        PontosDisponiveis > 0,
        'Existem controles de segurança com recursos não saudáveis ou avaliações pendentes',
        'A pontuação atual atingiu o máximo retornado para a iniciativa'
    ),
    Solucao = 'Correlacionar com os controles e recomendações do Defender for Cloud, priorizando impacto, recursos não saudáveis e viabilidade',
    Documentacao = 'https://learn.microsoft.com/azure/defender-for-cloud/secure-score-security-controls'
| join kind=leftouter (
    ResourceContainers
    | where type =~ 'microsoft.resources/subscriptions'
    | project subscriptionId, NomeSubscription = name
) on subscriptionId
| project-away subscriptionId1
| project
    NomeSubscription,
    subscriptionId,
    Iniciativa,
    ScoreAtual,
    ScoreMaximo,
    Percentual,
    PontosDisponiveis,
    Peso,
    Recomendacao,
    Causa,
    Solucao,
    Documentacao,
    ResourceId = id
| order by Percentual asc, NomeSubscription asc
