// Para filtrar por subscriptions, insira após a linha "Resources":
// | where subscriptionId in (
//     'SUBSCRIPTION-ID-1',
//     'SUBSCRIPTION-ID-2'
// )

Resources
| where type =~ "microsoft.compute/disks"
| join kind=leftouter (
    ResourceContainers
    | where type =~ "microsoft.resources/subscriptions"
    | project subscriptionId, subscriptionName = name
) on subscriptionId
| project-away subscriptionId1
| extend
    diskState = tostring(properties.diskState),
    attachedTo = tostring(managedBy)
| extend
    isUnattached = iff(isempty(attachedTo) or diskState =~ "Unattached", "SIM", "NAO")
| extend
    criadoEmTag = coalesce(
        tostring(tags["Criado em"]),
        tostring(tags["criado em"]),
        tostring(tags["CriadoEm"]),
        tostring(tags["createdOn"])
    )
| extend
    createdAtUTC = todatetime(properties.timeCreated),
    systemCreatedAtUTC = todatetime(systemData.createdAt),
    criadoEmTagUTC = todatetime(criadoEmTag)
| extend
    createdAtGMT3 = datetime_add("hour", -3, createdAtUTC),
    systemCreatedAtGMT3 = datetime_add("hour", -3, systemCreatedAtUTC),
    criadoEmTagGMT3 = datetime_add("hour", -3, criadoEmTagUTC)
| project
    subscriptionName,
    subscriptionId,
    resourceGroup,
    diskName = name,
    location,
    skuName = tostring(sku.name),
    skuTier = tostring(sku.tier),
    diskState,
    isUnattached,
    attachedTo,
    osType = tostring(properties.osType),
    diskSizeGB = tostring(properties.diskSizeGB),
    diskIOPSReadWrite = tostring(properties.diskIOPSReadWrite),
    diskMBpsReadWrite = tostring(properties.diskMBpsReadWrite),
    maxShares = tostring(properties.maxShares),
    networkAccessPolicy = tostring(properties.networkAccessPolicy),
    publicNetworkAccess = tostring(properties.publicNetworkAccess),
    zones = tostring(zones),
    createdAtUTC = format_datetime(createdAtUTC, "yyyy-MM-dd HH:mm:ss"),
    createdAtGMT3 = format_datetime(createdAtGMT3, "yyyy-MM-dd HH:mm:ss"),
    systemCreatedAtUTC = format_datetime(systemCreatedAtUTC, "yyyy-MM-dd HH:mm:ss"),
    systemCreatedAtGMT3 = format_datetime(systemCreatedAtGMT3, "yyyy-MM-dd HH:mm:ss"),
    createdBy = tostring(systemData.createdBy),
    criadoEmTag,
    criadoEmTagGMT3 = iff(
        isnotnull(criadoEmTagGMT3),
        format_datetime(criadoEmTagGMT3, "yyyy-MM-dd HH:mm:ss"),
        ""
    ),
    tags = tostring(tags),
    id
| order by isUnattached desc, subscriptionName asc, resourceGroup asc, diskName asc
