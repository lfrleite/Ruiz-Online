// Para filtrar por subscriptions, insira após a linha "Resources":
// | where subscriptionId in (
//     'SUBSCRIPTION-ID-1',
//     'SUBSCRIPTION-ID-2'
// )

Resources
| join kind=leftouter (
    ResourceContainers
    | where type =~ "microsoft.resources/subscriptions"
    | project subscriptionId, subscriptionName = name
) on subscriptionId
| project-away subscriptionId1
| extend tagEnvironment = coalesce(tostring(tags["Environment"]), tostring(tags["environment"]), tostring(tags["Ambiente"]), tostring(tags["ambiente"]), tostring(tags["ENV"]), tostring(tags["env"]))
| extend tagOwner = coalesce(tostring(tags["Owner"]), tostring(tags["owner"]), tostring(tags["Responsavel"]), tostring(tags["responsavel"]))
| extend tagCostCenter = coalesce(tostring(tags["CostCenter"]), tostring(tags["costcenter"]), tostring(tags["CentroCusto"]), tostring(tags["centroCusto"]), tostring(tags["Centro de Custo"]))
| extend tagApplication = coalesce(tostring(tags["Application"]), tostring(tags["application"]), tostring(tags["Aplicacao"]), tostring(tags["aplicacao"]), tostring(tags["Sistema"]), tostring(tags["sistema"]))
| extend tagCriticality = coalesce(tostring(tags["Criticality"]), tostring(tags["criticality"]), tostring(tags["Criticidade"]), tostring(tags["criticidade"]))
| extend searchText = tolower(strcat(subscriptionName, " ", resourceGroup, " ", name, " ", tostring(tags)))
| extend ambienteInferido = case(
    isnotempty(tagEnvironment), tagEnvironment,
    searchText contains "prd" or searchText contains "prod" or searchText contains "production", "PROD",
    searchText contains "hml" or searchText contains "homolog", "HML",
    searchText contains "dev" or searchText contains "desenv", "DEV",
    searchText contains "dr" or searchText contains "backup", "DR/BACKUP",
    searchText contains "test" or searchText contains "teste" or searchText contains "lab" or searchText contains "poc", "TESTE/LAB",
    "NAO_IDENTIFICADO"
)
| project
    subscriptionName,
    subscriptionId,
    resourceGroup,
    name,
    type,
    kind,
    location,
    skuName = tostring(sku.name),
    skuTier = tostring(sku.tier),
    skuSize = tostring(sku.size),
    zones = tostring(zones),
    managedBy,
    ambienteInferido,
    tagEnvironment,
    tagOwner,
    tagCostCenter,
    tagApplication,
    tagCriticality,
    createdAt = tostring(systemData.createdAt),
    createdBy = tostring(systemData.createdBy),
    lastModifiedAt = tostring(systemData.lastModifiedAt),
    lastModifiedBy = tostring(systemData.lastModifiedBy),
    tags = tostring(tags),
    id
| order by subscriptionName asc, resourceGroup asc, type asc, name asc
