DeviceTvmSecureConfigurationAssessment
| where IsApplicable == true
| where IsCompliant == false
| join kind=leftouter (
    DeviceTvmSecureConfigurationAssessmentKB
    | project
        ConfigurationId,
        ConfigurationName,
        ConfigurationDescription,
        RiskDescription,
        ConfigurationImpactKB = ConfigurationImpact,
        ConfigurationBenchmarks,
        Tags,
        RemediationOptions
) on ConfigurationId
| project-away ConfigurationId1
| extend
    ImpactoConfiguracao = coalesce(ConfigurationImpact, ConfigurationImpactKB),
    Recomendacao = ConfigurationName,
    Causa = RiskDescription,
    Solucao = RemediationOptions,
    Documentacao = 'https://learn.microsoft.com/defender-xdr/advanced-hunting-devicetvmsecureconfigurationassessmentkb-table'
| project
    DeviceId,
    DeviceName,
    OSPlatform,
    OSVersion,
    ConfigurationId,
    ConfigurationName,
    ConfigurationCategory,
    ConfigurationSubcategory,
    ConfigurationDescription,
    RiskDescription,
    ImpactoConfiguracao,
    IsExpectedUserImpact,
    RemediationOptions,
    ConfigurationBenchmarks,
    Tags,
    Context,
    Recomendacao,
    Causa,
    Solucao,
    Documentacao
| order by ImpactoConfiguracao desc, DeviceName asc, ConfigurationName asc
